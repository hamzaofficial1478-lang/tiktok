{
  "name": "tiktok-downloader",
  "version": "0.1.0",
  "description": "Desktop TikTok downloader with an ordered queue, deduplication, and watermark removal",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamzaofficial1478-lang/tiktok.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:live": "cross-env LIVE_PROBE=1 vitest run tests/live",
    "fetch:sidecars": "node scripts/fetch-sidecars.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "setup:electron": "node scripts/ensure-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "dist:win": "npm run preflight && electron-builder --win --publish never",
    "dist:mac": "npm run preflight && electron-builder --mac --publish never",
    "verify": "npm run typecheck && npm run test",
    "harness:queue": "node scripts/run-harness.mjs scripts/queue-harness.ts",
    "probe:ffmpeg": "node scripts/run-harness.mjs scripts/probe-ffmpeg.ts",
    "preflight": "npm run build && node scripts/run-harness.mjs scripts/preflight.ts",
    "preflight:personal": "npm run build && node scripts/run-harness.mjs scripts/preflight.ts --personal",
    "dist:win:personal": "npm run preflight:personal && electron-builder --win --publish never",
    "probe:captions": "node scripts/run-harness.mjs scripts/probe-captions.ts"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "better-sqlite3": "^13.0.3",
    "motion": "^13.1.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
